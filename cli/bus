#!/usr/bin/env node
// Inter-agent bus CLI — operator / user interface to the running broker.
// Registers itself ephemerally per invocation; no CLI state on disk.
//
// Usage:
//   bus list                      — list live participants
//   bus send <to> <body...>       — push a message to <to>
//   bus send --reply-to <id> <to> <body...>
//   bus send --allow-queued <to> <body...>
//   bus broker                    — run the broker in the foreground (fg daemon)
//
// Env:
//   AGENT_BUS_SOCKET            — broker socket path (default ~/.agent-bus/broker.sock)
//   AGENT_BUS_STATE_DIR         — broker state dir; if AGENT_BUS_SOCKET is unset, default socket becomes <state-dir>/broker.sock
//   BUS_JSON=1                    — emit machine-readable JSON instead of columns

'use strict';

const path = require('path');
const os = require('os');
const net = require('net');
const fs = require('fs');
const { spawn } = require('child_process');
const { BusClient } = require(path.resolve(__dirname, '..', 'client', 'client.js'));
const sessionAuth = require(path.resolve(__dirname, '..', 'adapters', 'session-auth.js'));

const argv = process.argv.slice(2);
const JSON_OUT = !!process.env.BUS_JSON;
const BUS_USAGE_PATH = 'USAGE.md';
const SOCKET_REQUEST_TIMEOUT_MS = Math.max(1, Number(process.env.AGENT_BUS_SOCKET_TIMEOUT_MS || '2000') || 2000);
const CODEX_DESKTOP_CONTROL = process.env.AGENT_BUS_CODEX_DESKTOP_CONTROL
  || path.resolve(__dirname, '..', 'adapters', 'codex-desktop', 'control.py');
// Control-socket ops that require the per-session capability token. Mirror of
// PRIVILEGED_CONTROL_TYPES in adapters/session-control.js. `status` is exempt.
const PRIVILEGED_CONTROL_TYPES = new Set(['enable', 'disable', 'whoami']);

function printUsage() {
  console.error('usage:');
  console.error('  bus list');
  console.error('  bus status [--session-id <id>]');
  console.error('  bus whoami [--session-id <id>]');
  console.error('  bus enable [--session-id <id>] [--name <bus-address>] [--description <text>]');
  console.error('  bus disable [--session-id <id>]');
  console.error('  bus send [--from-session] [--allow-queued] [--session-id <id>] [--reply-to <msg-id>] [--conversation-id <id>] [--source <source>] [--id <msg-id>] <participantId> <body...>');
  console.error('  bus broker   # run the broker in foreground');
  process.exit(1);
}

function formatRetryMessage(summary, steps = [], tail = null) {
  const lines = [`RETRY NOW: ${summary}`];
  if (steps.length) {
    lines.push('', 'Next steps:');
    for (const step of steps) lines.push(`- ${step}`);
  }
  if (tail) lines.push('', tail);
  return lines.join('\n');
}

function sendFailureMessage(result, { fromSession = false, sessionId = null } = {}) {
  const extra = result.reason ? ` (${result.reason})` : '';
  const from = result.from || '(unknown)';
  const statusLine = `${result.status}${extra}  from=${from}`;
  const steps = [];

  if (fromSession) {
    steps.push('Run `bus status` in this live session.');
  }

  if (result.status === 'queued') {
    if (result.reason === 'recipient_offline') {
      steps.push('Run `bus list` and confirm the peer is currently present.');
      steps.push('If the peer should be reachable now, have it run `bus status`, `bus enable --name ... --description ...`, then `bus whoami`.');
      steps.push('Resend only after the peer is live, or use `--allow-queued` only if mailbox delivery later is explicitly acceptable.');
      return `${statusLine}\n${formatRetryMessage(
        'message not delivered live; it was only queued for a later recipient reattach.',
        steps,
        `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as sent — fix the state and retry.`,
      )}`;
    }
    steps.push('Inspect the current bus state and retry only after the delivery path is healthy.');
    return `${statusLine}\n${formatRetryMessage(
      'message was queued instead of delivered.',
      steps,
      `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as sent — fix the state and retry.`,
    )}`;
  }

  if (result.status === 'failed' && result.reason === 'no_such_participant') {
    steps.push('Run `bus list` to discover the current live participant ids.');
    steps.push('Have the peer run `bus whoami` if you need its exact address.');
    steps.push('If the peer is not listed, have it run `bus status` and `bus enable --name ... --description ...`, then resend.');
    return `${statusLine}\n${formatRetryMessage(
      'the target participant is not currently known to the broker.',
      steps,
      `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as sent — fix the address/state and retry.`,
    )}`;
  }

  if (result.status === 'rejected') {
    if (result.reason === 'not_registered') {
      steps.push('Run `bus status`.');
      steps.push('If disabled, run `bus enable --name ... --description ...`, then resend.');
      return `${statusLine}\n${formatRetryMessage(
        'this live session is wrapped but not currently registered on the bus.',
        steps,
        `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as a bus failure — enable and retry.`,
      )}`;
    }
    if (typeof result.reason === 'string' && result.reason.startsWith('send_error:')) {
      steps.push('Run `bus status` and inspect `last_error` and `log=`.');
      steps.push('Fix the reported sidecar/broker issue, then resend.');
      return `${statusLine}\n${formatRetryMessage(
        'the live send path rejected the message before delivery.',
        steps,
        `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as sent — diagnose and retry.`,
      )}`;
    }
  }

  steps.push('Run `bus status`.');
  steps.push('If needed, run `bus list` / `bus whoami` to re-check the target and sender state.');
  return `${statusLine}\n${formatRetryMessage(
    'bus delivery did not complete.',
    steps,
    `If you are unsure about the workflow, read \`${BUS_USAGE_PATH}\`. Do not report this as sent — diagnose and retry.`,
  )}`;
}

function resolveAdapterSocketsDir() {
  if (process.env.AGENT_BUS_ADAPTER_SOCKETS_DIR) return process.env.AGENT_BUS_ADAPTER_SOCKETS_DIR;
  return path.join(os.homedir(), '.agent-bus', 'adapter-sockets');
}

function resolveControlSocketsDir() {
  if (process.env.AGENT_BUS_CONTROL_SOCKETS_DIR) return process.env.AGENT_BUS_CONTROL_SOCKETS_DIR;
  return path.join(os.homedir(), '.agent-bus', 'control-sockets');
}

function resolveCurrentSessionId(explicit) {
  if (explicit) return explicit;
  if (process.env.AGENT_BUS_SESSION_ID) return process.env.AGENT_BUS_SESSION_ID;
  if (process.env.CODEX_RUNTIME_SESSION_ID) return process.env.CODEX_RUNTIME_SESSION_ID;
  const desktopThreadId = resolveCodexDesktopThreadId();
  if (desktopThreadId) return codexDesktopSessionId(desktopThreadId);
  return null;
}

function resolveCodexDesktopThreadId() {
  const value = process.env.AGENT_BUS_THREAD_ID || process.env.CODEX_THREAD_ID || '';
  const trimmed = value.trim();
  if (!trimmed || trimmed === '.' || trimmed === '..' || trimmed.includes('/') || trimmed.includes('\0')) {
    return null;
  }
  return trimmed;
}

function codexDesktopSessionId(threadId) {
  return `codex-desktop-${threadId}`;
}

function codexDesktopDefaultName(threadId) {
  return codexDesktopSessionId(threadId).toLowerCase();
}

function isCurrentCodexDesktopSession(sessionId) {
  const threadId = resolveCodexDesktopThreadId();
  return !!threadId && sessionId === codexDesktopSessionId(threadId);
}

function requestSocket(socketPath, req, timeoutMs = SOCKET_REQUEST_TIMEOUT_MS) {
  return new Promise((resolve, reject) => {
    const c = net.createConnection(socketPath);
    let buffer = '';
    let settled = false;
    const finish = (fn, value) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      fn(value);
    };
    const timer = setTimeout(() => {
      const err = new Error(`socket request timed out after ${timeoutMs}ms`);
      err.code = 'ETIMEDOUT';
      c.destroy();
      finish(reject, err);
    }, timeoutMs);
    if (timer.unref) timer.unref();
    c.on('connect', () => c.write(JSON.stringify(req) + '\n'));
    c.on('data', (chunk) => {
      buffer += chunk.toString();
      const nl = buffer.indexOf('\n');
      if (nl === -1) return;
      const line = buffer.slice(0, nl);
      try {
        finish(resolve, JSON.parse(line));
      } catch (err) {
        finish(reject, err);
      } finally {
        c.end();
      }
    });
    c.on('error', (err) => finish(reject, err));
  });
}

function adapterSocketPathFor(sessionId) {
  return path.join(resolveAdapterSocketsDir(), `${sessionId}.sock`);
}

function controlSocketPathFor(sessionId) {
  return path.join(resolveControlSocketsDir(), `${sessionId}.sock`);
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function waitForControlReady(sessionId, timeoutMs = SOCKET_REQUEST_TIMEOUT_MS) {
  const deadline = Date.now() + Math.max(250, timeoutMs);
  let lastError = null;
  while (Date.now() < deadline) {
    try {
      await requestSocket(controlSocketPathFor(sessionId), { type: 'status' }, Math.min(250, SOCKET_REQUEST_TIMEOUT_MS));
      return;
    } catch (err) {
      lastError = err;
      await sleep(50);
    }
  }
  if (lastError) throw lastError;
}

async function ensureCodexDesktopControl(sessionId) {
  if (!isCurrentCodexDesktopSession(sessionId)) return;
  try {
    await requestSocket(controlSocketPathFor(sessionId), { type: 'status' }, Math.min(250, SOCKET_REQUEST_TIMEOUT_MS));
    return;
  } catch (err) {
    // Start or replace the Desktop control sidecar below. A stale socket will be
    // unlinked by the control process during startup.
  }

  const threadId = resolveCodexDesktopThreadId();
  if (!threadId) return;
  const logDir = process.env.AGENT_BUS_CONTROL_LOG_DIR || path.join(os.homedir(), '.agent-bus', 'control-logs');
  fs.mkdirSync(logDir, { recursive: true, mode: 0o700 });
  try { fs.chmodSync(logDir, 0o700); } catch {}
  const logPath = path.join(logDir, `${sessionId}.launcher.log`);
  const logFd = fs.openSync(logPath, 'a');
  try {
    const child = spawn('/usr/bin/python3', [
      CODEX_DESKTOP_CONTROL,
      '--auto-enable',
      '--name', codexDesktopDefaultName(threadId),
      '--description', `Codex Desktop thread ${threadId}`,
    ], {
      detached: true,
      stdio: ['ignore', logFd, logFd],
      cwd: process.cwd(),
      env: {
        ...process.env,
        AGENT_BUS_RUNTIME_SESSION_ID: sessionId,
        AGENT_BUS_THREAD_ID: threadId,
        AGENT_BUS_DESKTOP_CWD: process.cwd(),
      },
    });
    child.unref();
  } finally {
    fs.closeSync(logFd);
  }
  await waitForControlReady(sessionId);
}

async function requestSessionControl(req, explicitSessionId) {
  const resolvedSessionId = resolveCurrentSessionId(explicitSessionId);
  if (!resolvedSessionId) {
    throw new Error(formatRetryMessage(
      'no live wrapped session id is available in this shell.',
      [
        'Run this command inside a normal wrapped `claude` or `codex` session, or pass `--session-id` from another terminal.',
        'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
      ],
      'Do not assume the message was sent. Fix the session context and retry.',
    ));
  }

  await ensureCodexDesktopControl(resolvedSessionId);

  // Attach the per-session control capability token for privileged ops so the
  // wrapper accepts them (connection != authority). `status` is unauthenticated
  // and needs no token. The token file is 0600 in the control-sockets dir; if
  // it is missing we send without it and let the wrapper return `unauthorized`,
  // which surfaces a clear retry message rather than a silent state change.
  const authedReq = req;
  if (req && PRIVILEGED_CONTROL_TYPES.has(req.type)) {
    const token = sessionAuth.readToken(resolveControlSocketsDir(), resolvedSessionId);
    if (token) authedReq.auth = token;
  }

  try {
    return await requestSocket(controlSocketPathFor(resolvedSessionId), authedReq);
  } catch (err) {
    if (err && err.code === 'ENOENT') {
      throw new Error(formatRetryMessage(
        `no bus control socket exists for session ${resolvedSessionId}.`,
        [
          'Confirm the target session is still running and was launched through the normal wrapped `claude` / `codex` path, or from Codex Desktop with `CODEX_THREAD_ID` available.',
          'If you are calling from another terminal, pass the correct `--session-id`.',
          'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
        ],
        'Do not assume the message was sent. Fix the session state and retry.',
      ));
    }
    if (err && err.code === 'ECONNREFUSED') {
      throw new Error(formatRetryMessage(
        `the bus control socket for session ${resolvedSessionId} is stale or unreachable.`,
        [
          'Run `bus status --session-id ' + resolvedSessionId + '` from a control shell if available, or restart the wrapped session.',
          'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
        ],
        'Do not assume the message was sent. Repair the control path and retry.',
      ));
    }
    if (err && err.code === 'ETIMEDOUT') {
      throw new Error(formatRetryMessage(
        `the bus control socket for session ${resolvedSessionId} did not respond.`,
        [
          'The wrapped session may be wedged or the socket may be stale; restart that session if it does not recover.',
          'If you are calling from another terminal, pass the correct `--session-id`.',
          'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
        ],
        'Do not assume the message was sent. Repair the control path and retry.',
      ));
    }
    throw err;
  }
}

function parseSessionScopedArgs(args) {
  let sessionId = null;
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--session-id') sessionId = args[++i];
    else positional.push(args[i]);
  }
  if (positional.length !== 0) printUsage();
  return { sessionId };
}

function printSessionResult(result) {
  const state = result.state || result.status || 'unknown';
  const participant = result.participantId ? ` participant=${result.participantId}` : '';
  console.log(`${state}  kind=${result.kind || '-'} adapter=${result.adapter || '-'} session=${result.sessionId || '-'}${participant}`);
  if (result.displayName && result.displayName !== result.participantId) console.log(`name=${result.displayName}`);
  if (result.description) console.log(`description=${result.description}`);
  if (result.threadState || result.threadId) {
    const threadId = result.threadId ? ` ${result.threadId}` : '';
    console.log(`thread=${result.threadState || 'unknown'}${threadId}`);
  }
  console.log(`desired_enabled=${result.desiredEnabled ? 'yes' : 'no'} auto_enable=${result.autoEnable ? 'yes' : 'no'} enabled=${result.enabled ? 'yes' : 'no'}`);
  if (result.controlSocketPath) console.log(`control=${result.controlSocketPath}`);
  if (result.deliverySocketPath) console.log(`delivery=${result.deliverySocketPath}`);
  if (result.lastError) console.log(`last_error=${result.lastError}`);
  if (result.logPath) console.log(`log=${result.logPath}`);
}

async function cmdList() {
  const c = new BusClient();
  await c.connect();
  const { participants } = await c.list();
  if (JSON_OUT) {
    console.log(JSON.stringify(participants, null, 2));
  } else if (participants.length === 0) {
    console.log('(no participants registered)');
  } else {
    for (const p of participants) {
      const adapter = (p.delivery && p.delivery.adapter) || '-';
      const project = p.project || '-';
      const last = p.lastHeartbeat || '-';
      console.log(`${p.participantId.padEnd(24)}  adapter=${adapter.padEnd(18)} project=${project}  last=${last}`);
      if (p.displayName && p.displayName !== p.participantId) {
        console.log(`${' '.repeat(26)}  name=${p.displayName}`);
      }
      if (p.description) console.log(`${' '.repeat(26)}  desc=${p.description}`);
    }
  }
  if (c.socket) c.socket.end();
}

async function cmdStatus(args) {
  const { sessionId } = parseSessionScopedArgs(args);
  const result = await requestSessionControl({ type: 'status' }, sessionId);
  if (JSON_OUT) console.log(JSON.stringify(result, null, 2));
  else printSessionResult(result);
}

async function cmdEnable(args) {
  let sessionId = null;
  let displayName = null;
  let description = null;
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--session-id') sessionId = args[++i];
    else if (args[i] === '--name') displayName = args[++i];
    else if (args[i] === '--description') description = args[++i];
    else positional.push(args[i]);
  }
  if (positional.length !== 0) printUsage();
  const result = await requestSessionControl({ type: 'enable', displayName, description }, sessionId);
  if (JSON_OUT) console.log(JSON.stringify(result, null, 2));
  else printSessionResult(result);
  process.exitCode = result.status === 'error' ? 2 : 0;
}

async function cmdDisable(args) {
  const { sessionId } = parseSessionScopedArgs(args);
  const result = await requestSessionControl({ type: 'disable' }, sessionId);
  if (JSON_OUT) console.log(JSON.stringify(result, null, 2));
  else printSessionResult(result);
  process.exitCode = result.status === 'error' ? 2 : 0;
}

async function cmdWhoami(args) {
  const { sessionId } = parseSessionScopedArgs(args);
  const result = await requestSessionControl({ type: 'whoami' }, sessionId);
  if (JSON_OUT) console.log(JSON.stringify(result, null, 2));
  else if (result.participantId) console.log(result.participantId);
  else if (result.reason) console.log(result.reason);
  process.exitCode = result.participantId ? 0 : 2;
}

async function cmdSend(args) {
  let replyTo = null;
  let conversationId = null;
  let source = null;
  let messageId = null;
  let fromSession = false;
  let allowQueued = false;
  let sessionId = null;
  const positional = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--reply-to') { replyTo = args[++i]; }
    else if (args[i] === '--conversation-id') { conversationId = args[++i]; }
    else if (args[i] === '--source') { source = args[++i]; }
    else if (args[i] === '--id') { messageId = args[++i]; }
    else if (args[i] === '--from-session') { fromSession = true; }
    else if (args[i] === '--allow-queued') { allowQueued = true; }
    else if (args[i] === '--session-id') { sessionId = args[++i]; }
    else positional.push(args[i]);
  }
  if (positional.length < 2) printUsage();
  const [to, ...bodyParts] = positional;
  const body = bodyParts.join(' ');

  if (fromSession) {
    const resolvedSessionId = resolveCurrentSessionId(sessionId);
    if (!resolvedSessionId) {
      throw new Error(formatRetryMessage(
        'no live wrapped session id is available in this shell.',
        [
          'Run this command inside a normal wrapped `claude` or `codex` session, or pass `--session-id` from another terminal.',
          'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
        ],
        'Do not assume the message was sent. Fix the session context and retry.',
      ));
    }
    // Emitting as the live participant is privileged; present the adapter
    // capability token from the 0600 token file so the sidecar accepts the
    // {send}. A same-uid peer without the token is rejected as `unauthorized`.
    const adapterToken = sessionAuth.readToken(resolveAdapterSocketsDir(), resolvedSessionId);
    let result;
    try {
      result = await requestSocket(adapterSocketPathFor(resolvedSessionId), {
        type: 'send',
        to,
        body,
        id: messageId,
        reply_to: replyTo,
        conversation_id: conversationId,
        source: source || 'participant',
        ...(adapterToken ? { auth: adapterToken } : {}),
      });
    } catch (err) {
      if (err && (err.code === 'ENOENT' || err.code === 'ECONNREFUSED' || err.code === 'ETIMEDOUT')) {
        const status = await requestSessionControl({ type: 'status' }, resolvedSessionId);
        if (!status.enabled) {
          const detail = status.lastError ? ` last_error=${status.lastError}` : '';
          throw new Error(formatRetryMessage(
            `session ${resolvedSessionId} is not bus-enabled (${status.state || 'disabled'}).${detail}`,
            [
              'Run `bus enable --name "task-short-name" --description "What this session is doing"` in that live session.',
              'Run `bus whoami` to confirm the address after enable.',
              'Resend the message.',
              'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
            ],
            'Do not report this as a bus failure — the session can send once it is enabled.',
          ));
        }
        if (status.lastError) {
          throw new Error(formatRetryMessage(
            `session ${resolvedSessionId} bus sidecar is unavailable.`,
            [
              'Run `bus status` and inspect `last_error` and `log=`.',
              'Fix the reported sidecar/broker issue, then resend.',
              'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
            ],
            `Do not assume the message was sent. Diagnose and retry. last_error=${status.lastError}`,
          ));
        }
        if (err.code === 'ETIMEDOUT') {
          throw new Error(formatRetryMessage(
            `session ${resolvedSessionId} bus delivery socket did not respond.`,
            [
              'Run `bus status` and inspect `log=` for the live sidecar.',
              'Restart the wrapped session if the delivery socket stays unresponsive.',
              'If you are unsure about the workflow, read `' + BUS_USAGE_PATH + '`.',
            ],
            'Do not assume the message was sent. Repair the delivery path and retry.',
          ));
        }
      }
      throw err;
    }
    if (JSON_OUT) {
      console.log(JSON.stringify(result));
    } else {
      const extra = result.reason ? ` (${result.reason})` : '';
      const line = `${result.status}${extra}  from=${result.from || '(unknown)'}`;
      if (result.status === 'delivered') {
        console.log(line);
      } else if (result.status === 'queued' && allowQueued) {
        console.log(line);
      } else if (result.status === 'queued') {
        console.error(sendFailureMessage(result, { fromSession: true, sessionId: resolvedSessionId }));
      } else {
        console.error(sendFailureMessage(result, { fromSession: true, sessionId: resolvedSessionId }));
      }
    }
    process.exitCode = result.status === 'delivered' ? 0 : (result.status === 'queued' && allowQueued ? 0 : 2);
    return;
  }

  const c = new BusClient();
  await c.connect();
  await c.register({
    kind: 'cli',
    sessionId: `cli-${process.pid}-${Date.now()}`,
    project: 'bus-cli',
    cwd: process.cwd(),
    // No delivery socket — CLI is send-only. Broker gracefully handles
    // attempts to deliver back (returns rejected with no_delivery_socket).
    delivery: { adapter: 'cli-ephemeral' },
  });
  try {
    const result = await c.send(to, body, {
      id: messageId,
      replyTo,
      conversationId,
      source: source || 'participant',
    });
    if (JSON_OUT) {
      console.log(JSON.stringify(result));
    } else {
      const extra = result.reason ? ` (${result.reason})` : '';
      const line = `${result.status}${extra}  from=${result.from}`;
      if (result.status === 'delivered') {
        console.log(line);
      } else if (result.status === 'queued' && allowQueued) {
        console.log(line);
      } else if (result.status === 'queued') {
        console.error(sendFailureMessage(result));
      } else {
        console.error(sendFailureMessage(result));
      }
    }
    process.exitCode = result.status === 'delivered' ? 0 : (result.status === 'queued' && allowQueued ? 0 : 2);
  } finally {
    await c.unregister();
  }
}

function cmdBroker() {
  // Replace the process with the broker so signals/exit codes pass through.
  const brokerPath = path.resolve(__dirname, '..', 'broker', 'broker.js');
  const p = spawn(process.execPath, [brokerPath], { stdio: 'inherit' });
  p.on('exit', (code, sig) => process.exit(code ?? (sig ? 128 : 0)));
  p.on('error', (err) => { console.error('broker launch failed:', err.message); process.exit(1); });
}

async function main() {
  const cmd = argv[0];
  if (!cmd) printUsage();
  if (cmd === 'list' || cmd === 'ls') await cmdList();
  else if (cmd === 'status') await cmdStatus(argv.slice(1));
  else if (cmd === 'enable') await cmdEnable(argv.slice(1));
  else if (cmd === 'disable') await cmdDisable(argv.slice(1));
  else if (cmd === 'whoami') await cmdWhoami(argv.slice(1));
  else if (cmd === 'send') await cmdSend(argv.slice(1));
  else if (cmd === 'broker') cmdBroker();
  else if (cmd === 'help' || cmd === '--help' || cmd === '-h') printUsage();
  else {
    console.error(`unknown command: ${cmd}`);
    printUsage();
  }
}

main().catch((err) => {
  console.error('error:', err.message);
  process.exit(2);
});
